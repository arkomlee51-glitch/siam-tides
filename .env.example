# --- server (apps/server) ---
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# redis (ค่าเริ่มต้นนอก test) หรือ memory ถ้าไม่อยากรัน Redis ตอนพัฒนา
GAME_STORE=redis
LOG_LEVEL=info
# เกมที่ไม่มีใครแตะจะหมดอายุใน Redis หลังเวลานี้ (เฟส 4 จะมี Postgres รองรับ)
GAME_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=600
LOCK_TTL_MS=2000
LOCK_WAIT_MS=3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Supabase (Phase 4) — ใช้ค่าจาก `supabase status` ตอนรันแบบ local หรือจาก dashboard
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- web (apps/web) ---
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
