# --- server (apps/server) ---
PORT=8787
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379
# redis (ค่าเริ่มต้นนอก test) หรือ memory ถ้าไม่อยากรัน Redis ตอนพัฒนา
GAME_STORE=redis
LOG_LEVEL=info
# เกมที่ไม่มีใครแตะจะหมดอายุใน Redis หลังเวลานี้ — โหลดคืนได้จาก Supabase (snapshot + replay action log)
GAME_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=600
LOCK_TTL_MS=2000
LOCK_WAIT_MS=3000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Supabase (เฟส 4) — ใช้ค่าจาก `supabase status` ตอนรันแบบ local หรือจาก dashboard > Project Settings > API
SUPABASE_URL=http://127.0.0.1:54321
# service role (secret) key — server ใช้เขียนข้าม RLS ห้ามส่งให้ client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
# ใส่เฉพาะโปรเจกต์เก่าที่ยังไม่ได้ย้ายไป JWT signing keys — โปรเจกต์ใหม่เว้นว่างไว้ได้
# (server จะตรวจ JWT ด้วย JWKS ของ SUPABASE_URL แทนโดยอัตโนมัติ)
SUPABASE_JWT_SECRET=
# บังคับชนิด db; ถ้าไม่ใส่จะเป็น memory ตอน test และ supabase นอกจากนั้น
GAME_DB=

# --- web (apps/web) ---
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
